// Warehouse Management System - Prisma Schema
// Database: MySQL

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model untuk authentication
model user {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  email     String    @unique
  password  String
  name      String
  role      String    @default("staff") // admin, manager, staff
  warehouse_id String?
  warehouse warehouse? @relation(fields: [warehouse_id], references: [id])
  
  @@index([warehouse_id])
}

// Warehouse model untuk lokasi gudang
model warehouse {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  name      String
  location  String
  city      String
  capacity  Int       // total kapasitas dalam unit
  users     user[]
  inventories inventory_item[]
  items     item[]
  orders    orders[]
  shipments shipment[]
}

// Item model
model item {
  id                           String          @id @default(uuid())
  created_at                   DateTime        @default(now())
  updated_at                   DateTime        @default(now())
  deleted_at                   DateTime?
  created_by                   String?
  updated_by                   String?
  deleted_by                   String?
  code                         String          @unique
  name                         String
  status                       Boolean         @default(false)
  item_type_id                 String?
  classification_id            String?
  category_id                  String?
  contain                      String?
  uom_id                       String?
  capacity                     Int?
  control_stock                Boolean         @default(false)
  safety_stock                 Int             @default(0)
  brand_id                     String?
  specification                String?
  minimum_order_quantity       Int             @default(1)
  warehouse_id                 String?
  warehouse                    warehouse?      @relation(fields: [warehouse_id], references: [id])
  lead_time_in_days            Int             @default(1)
  certificate_of_analysis_id   String?
  minimum_wo_quantity          Int?
  max_balance_in_days          Int?
  remark                       String?
  inventories                  inventory_item[]
  order_details                order_detail[]

  @@index([item_type_id])
  @@index([classification_id])
  @@index([category_id])
  @@index([uom_id])
  @@index([brand_id])
  @@index([warehouse_id])
}

// Inventory Item - tracking stock per warehouse
model inventory_item {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  item_id   String
  item      item      @relation(fields: [item_id], references: [id])
  warehouse_id String
  warehouse warehouse @relation(fields: [warehouse_id], references: [id])
  quantity  Int
  min_stock  Int       @default(10)
  last_restocked DateTime @default(now())
  
  @@unique([item_id, warehouse_id])
  @@index([warehouse_id])
  @@index([item_id])
}

// Order model (bisa PO atau SO)
model orders {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  order_number String  @unique
  type      String    // "inbound" (PO) atau "outbound" (SO)
  warehouse_id String
  warehouse warehouse @relation(fields: [warehouse_id], references: [id])
  status    String    @default("pending") // pending, confirmed, shipped, delivered, cancelled
  total_amount Decimal @db.Decimal(15, 2)
  details   order_detail[]
  shipment  shipment?
  
  @@index([warehouse_id])
  @@index([status])
}

// Order Detail
model order_detail {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  order_id   String
  orders     orders     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  item_id   String
  item      item      @relation(fields: [item_id], references: [id])
  quantity  Int
  unit_price Decimal   @db.Decimal(12, 2)
  received  Int       @default(0)
  
  @@index([order_id])
  @@index([item_id])
}

// Shipment model
model shipment {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  order_id   String    @unique
  orders     orders     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  warehouse_id String
  warehouse warehouse @relation(fields: [warehouse_id], references: [id])
  tracking_number String @unique
  carrier   String?
  status    String    @default("pending") // pending, in_transit, delivered, cancelled
  shipped_at DateTime?
  delivered_at DateTime?
  trackings shipment_tracking[]
  
  @@index([warehouse_id])
  @@index([status])
}

// Shipment Tracking - untuk tracking history
model shipment_tracking {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  shipment_id String
  shipment  shipment  @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  status    String
  location  String?
  notes     String?
  timestamp DateTime  @default(now())
  
  @@index([shipment_id])
}

// Audit Log untuk tracking semua aksi
model audit_log {
  id        String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?
  action    String    // create, update, delete, status_change
  module    String    // user, item, inventory, orders, shipment
  record_id  String
  old_value  String?   @db.Text
  new_value  String?   @db.Text
  
  @@index([module])
  @@index([record_id])
}
